#!/usr/bin/env ruby
# frozen_string_literal: true

root = File.expand_path("..", __dir__)
require "rbconfig"

# Must run before the library is loaded: it uses syntax older Rubies cannot parse.
if (RUBY_VERSION.split(".").first(2).map(&:to_i) <=> [3, 2]) == -1
  abort(
    "session-memory needs Ruby 3.2+, but #{RbConfig.ruby} is #{RUBY_VERSION}.\n" \
    "Put a newer Ruby first on PATH (e.g. activate mise/rbenv), or run it explicitly:\n" \
    "  $(mise which ruby) #{File.join(root, "bin", "session-memory")} #{ARGV.join(" ")}".rstrip,
  )
end

begin
  require "bundler"
  gemfile = File.join(root, "Gemfile")
  lockfile = "#{gemfile}.lock"
  # Hooks may inherit another project's active bundle. Restart with our own.
  if ENV["BUNDLE_GEMFILE"] != gemfile || (ENV["BUNDLE_LOCKFILE"] && ENV["BUNDLE_LOCKFILE"] != lockfile)
    Bundler.with_unbundled_env do
      exec({ "BUNDLE_GEMFILE" => gemfile, "BUNDLE_LOCKFILE" => lockfile }, RbConfig.ruby, File.expand_path(__FILE__), *ARGV)
    end
  end
  require "bundler/setup"
  $LOAD_PATH.unshift(File.join(root, "lib")) unless $LOAD_PATH.include?(File.join(root, "lib"))
  require "session_memory"
rescue LoadError, StandardError => e
  warn("session-memory dependencies unavailable: #{e.message}\nRun bundle install in #{root}.")
  if ARGV.first == "hook"
    puts("{}") if %w[cursor codex].include?(ARGV[1])
    exit(0)
  end
  exit(1)
end

SessionMemory::CLI.run!(ARGV)
